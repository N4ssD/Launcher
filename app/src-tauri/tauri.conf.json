{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TonServeur",
  "version": "1.8.0",
  "identifier": "fr.n4ssd.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TonServeur",
        "width": 1180,
        "height": 740,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#1E1D1B",
        "decorations": false,
        "shadow": true,
        "transparent": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/N4ssD-Launcher/jeu/screenshots/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "N4ssD",
    "shortDescription": "Launcher du serveur Minecraft",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false,
        "template": "installer/installer.nsi"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgxMkZBOEVCNzY1QjRCREQKUldUZFMxdDI2Nmd2Z1hBK2plVnQ1U1h0dHliRnpCYXBUVFE1aEJBWVhXT3B0R1ZsZVFzWWhtcEQK",
      "endpoints": [
        "https://github.com/N4ssD/Launcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
