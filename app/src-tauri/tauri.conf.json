{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TonServeur",
  "version": "1.1.0",
  "identifier": "fr.n4ssd.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TonServeur",
        "width": 1180,
        "height": 740,
        "minWidth": 960,
        "minHeight": 620,
        "center": true,
        "backgroundColor": "#1E1D1B",
        "decorations": false,
        "shadow": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "N4ssD",
    "shortDescription": "Launcher du serveur Minecraft",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
